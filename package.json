{
  "name": "transaction-categoriser",
  "version": "1.0.0",
  "description": "API that accepts banking transactions and categorises them into 10 predefined categories",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
